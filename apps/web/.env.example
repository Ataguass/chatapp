# API URL reachable from the Next.js server.
MESSAGING_API_URL=http://127.0.0.1:4080
# API URL reachable from the browser for Socket.IO.
NEXT_PUBLIC_SOCKET_URL=http://127.0.0.1:4080
# Optional STUN fallback when the backend advertises no ICE servers.
# NEXT_PUBLIC_STUN_URL=stun:stun.example.com:3478
# Required for production web requests. Use the public HTTPS origin without a trailing slash.
# CHAT_WEB_ORIGIN=https://chat.example.com
