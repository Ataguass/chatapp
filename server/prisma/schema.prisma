generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ConversationKind {
  direct
  group
  @@map("conversation_kind")
}

enum MemberRole {
  owner
  admin
  member
  @@map("member_role")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique @db.VarChar(32)
  displayName  String   @map("display_name") @db.VarChar(100)
  passwordHash String   @map("password_hash")
  avatarUrl    String?  @map("avatar_url")
  bio          String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  devices      UserDevice[]
  memberships  ConversationMember[]
  directFirst  DirectConversation[] @relation("DirectFirst")
  directSecond DirectConversation[] @relation("DirectSecond")
  blocks       UserBlock[] @relation("Blocker")
  blockedBy    UserBlock[] @relation("Blocked")
  @@map("users")
}

model UserDevice {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  platform   String   @db.VarChar(16)
  deviceName String   @map("device_name") @db.VarChar(120)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions   UserSession[]
  @@unique([id, userId])
  @@index([userId])
  @@map("user_devices")
}

model UserSession {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  deviceId         String     @map("device_id") @db.Uuid
  refreshTokenHash String     @unique @map("refresh_token_hash") @db.Char(64)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz(3)
  device           UserDevice @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([deviceId, userId])
  @@map("user_sessions")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Conversation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind      ConversationKind @map("type")
  title     String?          @db.VarChar(120)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  members   ConversationMember[]
  direct    DirectConversation?
  @@map("conversations")
}

model DirectConversation {
  conversationId String       @id @map("conversation_id") @db.Uuid
  userOneId      String       @map("user_one_id") @db.Uuid
  userTwoId      String       @map("user_two_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  first          User         @relation("DirectFirst", fields: [userOneId], references: [id], onDelete: Restrict)
  second         User         @relation("DirectSecond", fields: [userTwoId], references: [id], onDelete: Restrict)
  @@unique([userOneId, userTwoId])
  @@index([userTwoId])
  @@map("direct_conversations")
}

model ConversationMember {
  conversationId String       @map("conversation_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           MemberRole   @default(member)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.Timestamptz(3)
  leftAt         DateTime?    @map("left_at") @db.Timestamptz(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages       Message[]
  @@id([conversationId, userId])
  @@index([userId, leftAt])
  @@map("conversation_members")
}

model Message {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String             @map("conversation_id") @db.Uuid
  senderId        String             @map("sender_id") @db.Uuid
  clientMessageId String             @map("client_message_id") @db.Uuid
  content         String
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt        DateTime?          @map("edited_at") @db.Timestamptz(3)
  deletedAt       DateTime?          @map("deleted_at") @db.Timestamptz(3)
  sender          ConversationMember @relation(fields: [conversationId, senderId], references: [conversationId, userId], onDelete: Cascade)
  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt, id])
  @@map("messages")
}
