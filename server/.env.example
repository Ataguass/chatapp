# Copy to server/.env (mode 0600). Use credentials for your own development services.
# Replace CHANGE_ME or supply DATABASE_URL_FILE and REDIS_URL_FILE instead.
DATABASE_URL=postgresql://messaging:CHANGE_ME@127.0.0.1:5432/messaging
REDIS_URL=redis://default:CHANGE_ME@127.0.0.1:6379/0
# Optional dedicated DDL account for Prisma migration commands:
# MIGRATION_DATABASE_URL_FILE=/run/secrets/messaging_migration_database_url
API_HOST=127.0.0.1
API_PORT=4080
HEALTH_TIMEOUT_MS=1500
NODE_ENV=development
