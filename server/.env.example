# Copy to server/.env (mode 0600). Use credentials for your own development services.
# Replace CHANGE_ME or supply DATABASE_URL_FILE and REDIS_URL_FILE instead.
DATABASE_URL=postgresql://messaging:CHANGE_ME@127.0.0.1:5432/messaging
REDIS_URL=redis://default:CHANGE_ME@127.0.0.1:6379/0
# Optional dedicated DDL account for Prisma migration commands:
# MIGRATION_DATABASE_URL_FILE=/run/secrets/messaging_migration_database_url
API_HOST=127.0.0.1
API_PORT=4080
# Only set to the exact addresses of proxies that control X-Forwarded-For.
# API_TRUSTED_PROXY_IPS=
HEALTH_TIMEOUT_MS=1500
MAX_GROUP_MEMBERS=100
# Relative paths resolve from the server working directory; use an absolute path in production.
MEDIA_STORAGE_PATH=./data/media
MEDIA_IMAGE_MAX_BYTES=10485760
MEDIA_VIDEO_MAX_BYTES=52428800
MEDIA_AUDIO_MAX_BYTES=20971520
MEDIA_DOCUMENT_MAX_BYTES=26214400
# Optional FCM HTTP v1 delivery. Use a protected Firebase service account file.
# For iOS, upload an Apple APNs authentication key in Firebase Console.
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=/absolute/path/firebase-service-account.json
# Optional STUN and Coturn endpoints. Mount the matching Coturn static-auth-secret for TURN.
# CALL_ICE_URLS=stun:turn.example.com:3478,turn:turn.example.com:3478?transport=udp
# CALL_TURN_SECRET_FILE=/run/secrets/chatapp_turn_secret
# Comma-separated Chatapp user UUIDs for system administration. Empty grants no administration access.
# SYSTEM_ADMIN_USER_IDS=
# Comma-separated exact browser origins, e.g. https://chat.example.com,http://localhost:3000
SOCKET_ALLOWED_ORIGINS=
NODE_ENV=development
