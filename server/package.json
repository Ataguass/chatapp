{
  "name": "@messaging/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate": "node --env-file-if-exists=.env scripts/prisma.ts generate",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "test": "node --test test/core/*.test.ts test/http/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test test/integration/*.test.ts",
    "db:validate": "node --env-file-if-exists=.env scripts/prisma.ts validate",
    "db:dev": "node --env-file-if-exists=.env scripts/prisma.ts dev",
    "db:deploy": "node --env-file-if-exists=.env scripts/prisma.ts deploy",
    "db:status": "node --env-file-if-exists=.env scripts/prisma.ts status",
    "db:drift": "node --env-file-if-exists=.env scripts/prisma.ts diff"
  },
  "dependencies": {
    "@messaging/contracts": "workspace:*",
    "@prisma/client": "6.19.3",
    "express": "5.2.1",
    "ioredis": "5.8.2",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
