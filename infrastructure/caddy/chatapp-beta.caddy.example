# Render with infrastructure/scripts/render-chatapp-beta-caddy.sh before merging.
CHATAPP_SITE {
	CHATAPP_TLS
	basic_auth {
		CHATAPP_BETA_USER CHATAPP_BETA_HASH
	}
	header Strict-Transport-Security "max-age=86400"

	handle /socket.io/* {
		reverse_proxy 127.0.0.1:4080 {
			header_up -Authorization
		}
	}

	handle {
		reverse_proxy 127.0.0.1:4300 {
			header_up -Authorization
		}
	}
}
